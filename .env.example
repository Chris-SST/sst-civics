# Copy to .env and fill in. Never commit .env.

# Runtime: dev | test | staging | production
APP_ENV=dev
SECRET_KEY=change-me-to-a-long-random-string
APP_BASE_URL=http://localhost:5173
MAIN_SITE_URL=https://swisssciencetutors.ch
LOG_LEVEL=INFO
# Error tracking (Sentry-compatible DSN; GlitchTip self-hosted or Sentry EU). Empty disables.
SENTRY_DSN=

# Data stores
DATABASE_URL=postgresql+asyncpg://sst:sst@localhost:5432/sst
REDIS_URL=redis://localhost:6379/0
# true: run background jobs in-process (local development without Redis)
JOBS_INLINE=false

# Stripe: TEST MODE keys until Chris approves go-live
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_API_VERSION=2026-05-27.dahlia

# Email: console (writes .eml files to var/outbox) | smtp
EMAIL_BACKEND=console
EMAIL_FROM="SST Virtual Tutor <tutor@swisssciencetutors.ch>"
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Photo storage, Swiss S3-compatible (Phase 1)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# AI provider (Phase 1). Server only.
ANTHROPIC_API_KEY=
# Development only: canned tutor replies without an API key (ignored outside dev/test)
LLM_FAKE=false
TUTOR_MODEL=claude-sonnet-5-5
FAST_MODEL=claude-haiku-5-5
TUTOR_EFFORT=medium
TUTOR_NAME=SST Virtual Tutor
DISCLOSE_MODEL_PROVIDER=true
USD_CHF_RATE=0.80
AI_MONTHLY_BUDGET_CHF=300
AI_STUDENT_ALERT_CHF=8
SAFEGUARDING_EMAIL=
# Staging and development only: also serve auto-verified (not yet tutor-reviewed) questions
SERVE_UNREVIEWED_QUESTIONS=false

# Other providers (later phases)
SCREENING_API_KEY=
TUTORCRUNCHER_API_KEY=
TUTORCRUNCHER_SSO_KEY=

# Docker Compose only
POSTGRES_PASSWORD=change-me
DOMAIN=staging.tutor.swisssciencetutors.ch
ACME_EMAIL=tutor@swisssciencetutors.ch
