# Copy to .env and fill in. Never commit .env.

# Runtime: dev | test | staging | production
APP_ENV=dev
SECRET_KEY=change-me-to-a-long-random-string
# Key material for encrypting TOTP secrets at rest. Empty: derived from SECRET_KEY.
# Changing it (or SECRET_KEY when this is empty) means admins set up 2FA again.
TOTP_ENCRYPTION_KEY=
APP_BASE_URL=http://localhost:5173
LOG_LEVEL=INFO
# Error tracking (Sentry-compatible DSN; GlitchTip self-hosted or Sentry EU). Empty disables.
SENTRY_DSN=

# Data stores
DATABASE_URL=postgresql+asyncpg://civics:civics@localhost:5432/civics
REDIS_URL=redis://localhost:6379/0
# true: run background jobs in-process (local development without Redis)
JOBS_INLINE=false

# Stripe: TEST MODE keys until Chris approves go-live
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_API_VERSION=2026-05-27.dahlia

# Email: console (writes .eml files to var/outbox) | smtp
EMAIL_BACKEND=console
EMAIL_FROM="SST Virtual Tutor <tutor@swisssciencetutors.ch>"
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# AI provider (Phase 1). Server only.
ANTHROPIC_API_KEY=
# Development only: canned tutor replies without an API key (ignored outside dev/test)
LLM_FAKE=false
TUTOR_MODEL=claude-sonnet-5-5
FAST_MODEL=claude-haiku-5-5
TUTOR_EFFORT=medium
TUTOR_NAME=SST Virtual Tutor
DISCLOSE_MODEL_PROVIDER=true
USD_CHF_RATE=0.80
AI_MONTHLY_BUDGET_CHF=300
AI_LEARNER_ALERT_CHF=8
# Staging and development only: also serve auto-verified (not yet tutor-reviewed) questions
SERVE_UNREVIEWED_QUESTIONS=false

# Docker Compose only
POSTGRES_PASSWORD=change-me
