# Internal web server for the civics stack. Plain HTTP on port 80, reachable only over the
# Docker networks; TLS and HSTS are handled by the shared edge Caddy (see edge-snippet.Caddyfile).
# Two hosts: the guide site (static files from /srv/site/current, D-056) and, as the catch-all
# ":80" block, the app host (SPA plus /api). The edge passes the original Host header through.
# This file is copied into the image at build: rebuild the web service after any change.
{
	auto_https off

	# The only client of this Caddy is the shared edge Caddy, on the private Docker network.
	# Trust its X-Forwarded-For so the real client address reaches the API. Without this,
	# Caddy replaces the header with the edge container's address and every per-IP rate limit
	# in the API becomes one global counter. The edge sets the header from the real
	# connection (it faces the internet and trusts nobody), then this Caddy appends the edge's
	# address, giving "client, edge". client_ip() in app/deps.py reads the FIRST entry.
	# Do not publish this server's port: a direct client could then forge the header.
	servers {
		trusted_proxies static private_ranges
	}
}

# Guide site (D-056): static Astro build, released by scripts/deploy_site.sh into
# /opt/civics/site-releases/releases/<sha>/ with a relative symlink "current" (mounted read-only
# at /srv/site). GO-LIVE: edit this host list to the brand domain (apex and www) and change
# the same list in infra/edge-snippet.Caddyfile. Staging today:
http://civics-staging.swisssciencetutors.ch {
	root * /srv/site/current
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Same policy as the app, without Stripe. Umami's tracker and collect endpoint are served
		# from this same origin under /stats/ (D-062), so script-src and connect-src need nothing extra.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# Hashed build files and fonts never change under the same name; pages revalidate.
	@immutable path /_astro/* /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@pages not path /_astro/* /fonts/*
	header @pages Cache-Control "public, max-age=300, must-revalidate"

	# Analytics (D-062): only the tracker script and the collect endpoint are public on this
	# host. Umami's dashboard cannot run under a sub-path (its BASE_PATH is fixed at build time
	# and the official image is prebuilt), so it lives on the stats host below. handle_path strips
	# /stats, so Umami sees /script.js and /api/send. Anything else under /stats/ is a 404.
	handle_path /stats/script.js {
		rewrite * /script.js
		reverse_proxy umami:3000
	}
	handle_path /stats/api/send {
		rewrite * /api/send
		reverse_proxy umami:3000
	}
	handle /stats/* {
		respond "Not found" 404
	}

	try_files {path} {path}/index.html
	file_server

	handle_errors {
		rewrite * /404.html
		file_server
	}

	log {
		output stdout
		format json
	}
}

# Umami dashboard (D-062). Log in here; see docs/runbooks/analytics.md. GO-LIVE: change the host
# to stats.<brand domain> here and in infra/edge-snippet.Caddyfile.
http://stats.civics-staging.swisssciencetutors.ch {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy umami:3000

	log {
		output stdout
		format json
	}
}

# GO-LIVE: add "http://www.<brand domain> { redir https://<brand domain>{uri} permanent }" here
# and www.<brand domain> to the edge host list.

# App host (and any other host): the React app and /api.
:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://checkout.stripe.com https://billing.stripe.com"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv/web
		# Hashed assets are immutable; the shell and service worker must revalidate.
		@assets path /assets/* /fonts/* /brand/* /icons/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@shell path /index.html /sw.js /manifest.webmanifest /registerSW.js
		header @shell Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
