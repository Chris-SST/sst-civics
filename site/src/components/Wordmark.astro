---
// Speech-bubble mark plus the brand name as text. Keep in step with web/src/components/Wordmark.tsx.
import { BRAND_NAME } from "../brand";
interface Props { small?: boolean }
const { small = false } = Astro.props;
---
<span class:list={["wordmark", { "wordmark-sm": small }]}>
  <span class="wordmark-mark" aria-hidden="true">
    <svg width="26" height="26" viewBox="0 0 32 32" focusable="false">
      <path d="M6 8h14a4 4 0 0 1 0 8H12l-4 4V8z" fill="var(--on-primary)" />
      <circle cx="23" cy="21" r="4" fill="var(--accent)" />
    </svg>
  </span>
  <span class="wordmark-name">{BRAND_NAME}</span>
</span>
