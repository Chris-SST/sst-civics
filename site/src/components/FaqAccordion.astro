---
// Native <details> accordion plus FAQPage JSON-LD. `text` is the plain-text answer for the markup;
// `Content` renders the answer, or the plain text is shown when there is none (article FAQs).
interface Item { question: string; text: string; Content?: any }
interface Props { items: Item[]; lang: string }
const { items, lang } = Astro.props;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: lang,
  mainEntity: items.map((i) => ({
    "@type": "Question",
    name: i.question,
    acceptedAnswer: { "@type": "Answer", text: i.text },
  })),
};
---
<div class="cv-faq">
  {items.map((i, n) => (
    <details open={n === 0}>
      <summary>{i.question}</summary>
      <div>{i.Content ? <i.Content /> : <p>{i.text}</p>}</div>
    </details>
  ))}
</div>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "<")}></script>
