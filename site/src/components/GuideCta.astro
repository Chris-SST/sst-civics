---
// Card at the end of every guide page: the route into the app.
import { APP_URL } from "astro:env/server";
import { ui } from "../i18n/ui";
interface Props { lang: string; variant?: "free-questions" | "mock" | "pass" }
const { lang, variant = "free-questions" } = Astro.props;
const copy = ui(lang).cta[variant];
// The free-questions and pass cards ("Try 30 free questions") open the no-account practice
// page; the mock-test card needs an account, so it goes to sign-up.
const page = variant === "mock" ? "signup" : "try";
const href = `${APP_URL.replace(/\/+$/, "")}/${page}?lang=${encodeURIComponent(lang)}`;
---
<aside class="cv-cta" aria-labelledby="cta-h">
  <div>
    <h2 id="cta-h">{copy.heading}</h2>
    <p>{copy.text}</p>
  </div>
  <a href={href} class="cv-btn cv-btn--primary" data-umami-event={`cta-${variant}`}>{copy.button}</a>
</aside>
