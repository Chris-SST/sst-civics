---
// "/" is a small page that sends visitors to /en/ (meta refresh plus a visible link, no script);
// the server redirects "/" to /en/ before this page is reached (infra/Caddyfile). hreflang
// x-default points at /en/ as well (Chris, 3 November 2026: English is the default).
import "../styles/global.css";
import { LOCALES, LOCALE_NAMES, pathFor } from "../i18n/pages.mjs";
import { BRAND_NAME } from "../brand";
const site = (Astro.site ?? new URL("https://staging.viapunt.ch")).toString().replace(/\/$/, "");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{BRAND_NAME}</title>
    <meta name="description" content="Naturalisation in Switzerland: guides and free practice questions. Einbürgerung in der Schweiz: Ratgeber und Gratis-Übungsfragen." />
    <meta http-equiv="refresh" content="0; url=/en/" />
    <link rel="canonical" href={`${site}/en/`} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={site + pathFor(l, "home")} />)}
    <link rel="alternate" hreflang="x-default" href={`${site}/en/`} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
  </head>
  <body>
    <main class="container main">
      <p><a href="/en/">Continue in English</a> · <a href="/de/">Weiter auf Deutsch</a></p>
      <p>
        {LOCALES.map((l, i) => (<>{i > 0 && " · "}<a href={pathFor(l, "home")} lang={l} hreflang={l}>{LOCALE_NAMES[l]}</a></>))}
      </p>
    </main>
  </body>
</html>
