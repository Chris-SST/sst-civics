---
// One route file for every page: home, guide pages from the content collection, legal and
// contact pages (German and English), articles and canton guides (docs/articles-contract.md),
// and template pages (calculator, FAQ, free practice, glossary, eligibility check, Zurich
// checklist, article and canton indexes) for languages that have no guide file for them.
// URLs are /<lang>/ and /<lang>/<slug>/ for all eight languages; articles are
// /<lang>/<segment>/<slug>/.
import { getCollection, render } from "astro:content";
import { APP_URL } from "astro:env/server";
import {
  LOCALES, STATIC_KEYS, buildIndex, alternatesFor, resolveHref, keyFor, slugFor, pathFor, articlePath,
} from "../i18n/pages.mjs";
import { ui } from "../i18n/ui";
import { more } from "../i18n/more";
import { plainText } from "../i18n/fmt";
import { glossaryFor } from "../glossary.mjs";
import { CATEGORIES } from "../articles/source.mjs";
import { allArticles, forLang } from "../articles/lib";
import Base from "../layouts/Base.astro";
import Guide from "../layouts/Guide.astro";
import GuideCta from "../components/GuideCta.astro";
import ResidenceCalculator from "../components/ResidenceCalculator.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import Home from "../components/Home.astro";
import ArticleLayout from "../components/ArticleLayout.astro";
import ArticlePage from "../components/ArticlePage.astro";
import ArticleList from "../components/ArticleList.astro";
import EligibilityCheck from "../components/EligibilityCheck.astro";
import ZurichChecklist from "../components/ZurichChecklist.astro";

export async function getStaticPaths() {
  const guide = await getCollection("guide", (e) => !e.data.draft);
  const paths: { params: { path: string }; props: Record<string, unknown> }[] = [];

  for (const lang of LOCALES) paths.push({ params: { path: lang }, props: { kind: "home", lang, key: "home" } });

  const haveGuide = new Set<string>();
  for (const entry of guide) {
    const { lang, slug } = entry.data;
    const key = keyFor(lang, slug);
    haveGuide.add(`${lang}/${key}`);
    paths.push({ params: { path: `${lang}/${slug}` }, props: { kind: "guide", lang, key, id: entry.id } });
  }
  for (const entry of await getCollection("legal")) {
    const { lang, slug } = entry.data;
    paths.push({ params: { path: `${lang}/${slug}` }, props: { kind: "legal", lang, key: keyFor(lang, slug), id: entry.id } });
  }
  for (const lang of LOCALES) {
    for (const key of STATIC_KEYS) {
      if (haveGuide.has(`${lang}/${key}`)) continue;
      paths.push({ params: { path: `${lang}/${slugFor(key, lang)}` }, props: { kind: key, lang, key } });
    }
  }
  for (const entry of await allArticles()) {
    const { lang, kind, key, slug } = entry.data;
    paths.push({
      params: { path: articlePath(lang, kind, slug).replace(/^\/|\/$/g, "") },
      props: { kind: "article-page", lang, key: `article:${key}`, id: entry.id },
    });
  }
  return paths;
}

const { kind, lang, key, id } = Astro.props as { kind: string; lang: string; key: string; id?: string };
const t = ui(lang);
const mo = more(lang);

const guideAll = await getCollection("guide", (e) => !e.data.draft);
const legalAll = await getCollection("legal");
const articlesAll = await allArticles();
const index = buildIndex(
  [...guideAll, ...legalAll].map((e) => ({ lang: e.data.lang, slug: e.data.slug })),
  articlesAll.map((e) => ({ lang: e.data.lang, key: e.data.key, kind: e.data.kind, slug: e.data.slug })),
);
const alternates = alternatesFor(index, key);
const path = pathFor(lang, key.startsWith("article:") ? "home" : key);

const entry = id && kind === "guide" ? guideAll.find((e) => e.id === id) : undefined;
const rendered = entry ? await render(entry) : undefined;
const legalEntry = id && kind === "legal" ? legalAll.find((e) => e.id === id) : undefined;
const legalRendered = legalEntry ? await render(legalEntry) : undefined;
const articleEntry = id && kind === "article-page" ? articlesAll.find((e) => e.id === id) : undefined;
const articlePagePath = articleEntry ? articlePath(lang, articleEntry.data.kind, articleEntry.data.slug) : path;

// Articles that name this guide page in `related`, for the "Related articles" block.
const guideRelatedArticles = kind === "guide" ? forLang(articlesAll, lang).filter((e) => e.data.related.includes(key)) : [];

// FAQ items: this language, else English, else German.
let faqItems: { question: string; text: string; Content: any }[] = [];
if (kind === "faq") {
  const all = await getCollection("faq");
  for (const l of [lang, "en", "de"]) {
    const rows = all.filter((e) => e.data.lang === l).sort((a, b) => a.data.order - b.data.order);
    if (rows.length) {
      faqItems = await Promise.all(
        rows.map(async (r) => ({ question: r.data.question, text: plainText(r.body ?? ""), Content: (await render(r)).Content })),
      );
      break;
    }
  }
}
// The free-practice page's button opens the no-account practice page in the app.
const appHref = `${APP_URL.replace(/\/+$/, "")}/try?lang=${encodeURIComponent(lang)}`;

// Template pages: glossary, article and canton indexes.
const site = (Astro.site ?? new URL("https://viapunt.ch")).toString().replace(/\/$/, "");
const glossary = kind === "glossary" ? glossaryFor(lang) : [];
const glossaryLd =
  kind === "glossary"
    ? {
        "@context": "https://schema.org",
        "@type": "DefinedTermSet",
        name: mo.glossary.setName,
        inLanguage: lang,
        url: site + path,
        hasDefinedTerm: glossary.map((g) => ({
          "@type": "DefinedTerm",
          name: g.term,
          termCode: g.id,
          url: `${site}${path}#${g.id}`,
          description: [g.translation, g.note].filter(Boolean).join(": "),
          inLanguage: "de",
        })),
      }
    : null;
const articleList = kind === "articles" ? forLang(articlesAll, lang).filter((e) => e.data.kind === "article") : [];
const cantonList =
  kind === "cantons"
    ? forLang(articlesAll, lang)
        .filter((e) => e.data.kind === "canton")
        .sort((a, b) => (a.data.canton ?? "").localeCompare(b.data.canton ?? "") || a.data.title.localeCompare(b.data.title))
    : [];
const hasCantons = forLang(articlesAll, lang).some((e) => e.data.kind === "canton");
const hasArticles = forLang(articlesAll, lang).some((e) => e.data.kind === "article");
const eligHrefs = Object.fromEntries(
  ["overview", "zurich", "calculator", "language", "test", "fees"].map((k) => [k, resolveHref(index, k, lang)]),
);
---
{kind === "home" && (
  <Base lang={lang} title={t.home.title} description={t.home.description} alternates={alternates} path={path} wide>
    <Home lang={lang} index={index} />
  </Base>
)}

{kind === "guide" && entry && rendered && (
  <Guide
    lang={lang}
    title={entry.data.title}
    description={entry.data.description}
    alternates={alternates}
    path={path}
    headings={rendered.headings}
    lastChecked={entry.data.lastChecked}
    sources={entry.data.sources}
    cta={entry.data.cta}
    relatedArticles={guideRelatedArticles}
  >
    <rendered.Content />
    {key === "calculator" && <div style="margin-top:32px"><ResidenceCalculator lang={lang} /></div>}
  </Guide>
)}

{kind === "article-page" && articleEntry && (
  <ArticlePage entry={articleEntry} alternates={alternates} path={articlePagePath} index={index} />
)}

{kind === "legal" && legalEntry && legalRendered && (
  <Base lang={lang} title={legalEntry.data.title} description={legalEntry.data.description} alternates={alternates} path={path}>
    <ArticleLayout lang={lang} title={legalEntry.data.title} headings={legalRendered.headings}>
      {legalEntry.data.notice && <p class="notice" role="note">{legalEntry.data.notice}</p>}
      <div lang={legalEntry.data.contentLang ?? lang}><legalRendered.Content /></div>
    </ArticleLayout>
  </Base>
)}

{kind === "calculator" && (
  <Base lang={lang} title={t.calcPage.title} description={t.calcPage.description} alternates={alternates} path={path}>
    <div class="page stack">
      <h1>{t.calcPage.h1}</h1>
      <ResidenceCalculator lang={lang} />
      <section><h2>{t.calc.ruleTitle}</h2><p>{t.calc.ruleText}</p></section>
      <GuideCta lang={lang} />
    </div>
  </Base>
)}

{kind === "faq" && (
  <Base lang={lang} title={t.faqPage.title} description={t.faqPage.description} alternates={alternates} path={path}>
    <div class="page stack">
      <h1>{t.faqPage.h1}</h1>
      {faqItems.length > 0 ? <FaqAccordion items={faqItems} lang={lang === "de" ? "de" : "en"} /> : <p>{t.faqPage.empty}</p>}
      <p><a href={resolveHref(index, "overview", lang) ?? pathFor(lang, "home")}>{t.faqPage.more}</a></p>
      <GuideCta lang={lang} />
    </div>
  </Base>
)}

{kind === "free" && (
  <Base lang={lang} title={t.free.title} description={t.free.description} alternates={alternates} path={path}>
    <div class="page stack">
      <h1>{t.free.h1}</h1>
      <p>{t.free.lead}</p>
      <ul>{t.free.points.map((p) => <li>{p}</li>)}</ul>
      <section><h2>{t.free.how}</h2><p>{t.free.howText}</p><p><a class="cv-btn cv-btn--primary" href={appHref}>{t.free.button}</a></p></section>
      <p class="muted">{t.free.mockNote}</p>
      <GuideCta lang={lang} />
    </div>
  </Base>
)}

{kind === "glossary" && glossaryLd && (
  <Base lang={lang} title={mo.glossary.title} description={mo.glossary.description} alternates={alternates} path={path}>
    <script type="application/ld+json" set:html={JSON.stringify(glossaryLd).replace(/</g, "<")}></script>
    <div class="page stack">
      <h1>{mo.glossary.h1}</h1>
      <p>{mo.glossary.lead}</p>
      {lang === "de" && mo.glossary.noteDe && <p class="notice" role="note">{mo.glossary.noteDe}</p>}
      <dl class="gl-list">
        {glossary.map((g) => (
          <div class="gl-item" id={g.id}>
            <dt><a href={`#${g.id}`} lang="de">{g.term}</a></dt>
            <dd lang={g.fallback ? "en" : lang}>{g.translation}{g.fallback && lang !== "de" && <span class="muted"> ({mo.glossary.inEnglish})</span>}</dd>
            {g.note && <dd lang={g.noteFallback ? "en" : lang}>{g.note}</dd>}
          </div>
        ))}
      </dl>
      <GuideCta lang={lang} />
    </div>
  </Base>
)}

{kind === "eligibility" && (
  <Base lang={lang} title={mo.eligibility.title} description={mo.eligibility.description} alternates={alternates} path={path}>
    <div class="page stack">
      <h1>{mo.eligibility.h1}</h1>
      <EligibilityCheck lang={lang} hrefs={eligHrefs} />
      <GuideCta lang={lang} />
    </div>
  </Base>
)}

{kind === "checklist" && (
  <Base lang={lang} title={mo.checklist.title} description={mo.checklist.description} alternates={alternates} path={path}>
    <div class="page stack">
      <h1>{mo.checklist.h1}</h1>
      <p>{mo.checklist.lead}</p>
      <ZurichChecklist lang={lang} documentsHref={resolveHref(index, "documents", lang)} />
      <GuideCta lang={lang} />
    </div>
  </Base>
)}

{kind === "articles" && (
  <Base lang={lang} title={mo.articles.indexTitle} description={mo.articles.indexDescription} alternates={alternates} path={path} noindex={!hasArticles}>
    <div class="page page--wide stack">
      <h1>{mo.articles.indexH1}</h1>
      <p>{mo.articles.indexLead}</p>
      {!hasArticles && (
        <p>{mo.articles.soon} <a href={resolveHref(index, "overview", lang) ?? pathFor(lang, "home")}>{t.cards.overview.title}</a></p>
      )}
      {CATEGORIES.map((c) => {
        const rows = articleList.filter((e) => e.data.category === c);
        return rows.length > 0 && (
          <section class="art-group" aria-labelledby={`cat-${c}`}>
            <h2 id={`cat-${c}`}>{mo.articles.categories[c as keyof typeof mo.articles.categories]}</h2>
            <ArticleList entries={rows} lang={lang} showCategory={false} />
          </section>
        );
      })}
      {hasCantons && <p class="art-index-link"><a href={pathFor(lang, "cantons")}>{mo.articles.toCantons} →</a></p>}
      <p class="muted"><a href={`${pathFor(lang, "articles")}rss.xml`} type="application/rss+xml">{mo.articles.rss}</a></p>
      <GuideCta lang={lang} />
    </div>
  </Base>
)}

{kind === "cantons" && (
  <Base lang={lang} title={mo.articles.cantonsTitle} description={mo.articles.cantonsDescription} alternates={alternates} path={path} noindex={!hasCantons}>
    <div class="page page--wide stack">
      <h1>{mo.articles.cantonsH1}</h1>
      <p>{mo.articles.cantonsLead}</p>
      {cantonList.length === 0 && <p>{mo.articles.cantonsSoon}</p>}
      {cantonList.length > 0 && <ArticleList entries={cantonList} lang={lang} />}
      <p class="art-index-link"><a href={pathFor(lang, "articles")}>{mo.articles.toArticles} →</a></p>
      <GuideCta lang={lang} />
    </div>
  </Base>
)}
